package com.ptit.core_platform_service.controller;

import com.ptit.core_platform_service.entity.Analysis;
import com.ptit.core_platform_service.service.AnalysisService;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.*;

import java.util.List;
import java.util.UUID;

@RestController
@RequestMapping("/api/analyses")
@RequiredArgsConstructor
public class AnalysisController {

    private final AnalysisService analysisService;

    @GetMapping("/{analysisId}")
    public Analysis getById(@PathVariable UUID analysisId) {
        return analysisService.getById(analysisId);
    }

    @GetMapping("/cv/{cvId}")
    public List<Analysis> getByCvId(@PathVariable UUID cvId) {
        return analysisService.getByCvId(cvId);
    }

    @GetMapping("/jd/{jdId}")
    public List<Analysis> getByJdId(@PathVariable UUID jdId) {
        return analysisService.getByJdId(jdId);
    }
}